{
  "schemaVersion": "2.0",
  "name": "Games",
  "slug": "games",
  "type": "fastapi-react-app",
  "visibility": "public",
  "hostBase": "games.life.local",
  "inherits": "../Life/node.config",
  "packages": ["@suite/i18n"],
  "taxonomy": {
    "id": "games",
    "cluster": [
      "Learn"
    ],
    "displayName": "Games",
    "commercial": false
  },
  "tooling": {
    "grants": [
      { "kind": "mcp-toolset", "ref": "db,brain", "scope": "self" }
    ],
    "subagents": {
      "api-reviewer": { "toolsets": ["brain"] },
      "ui-reviewer": { "toolsets": ["brain"] }
    }
  },
  "capabilities": [],
  "agents": {
    "archetypes": []
  },
  "mcp": {
    "toolsets": []
  },
  "deploy": {
    "appModule": "games_backend.app:app",
    "healthPath": "/health",
    "migrations": true,
    "database": {
      "name": "games",
      "user": "games",
      "host": "games-db",
      "driver": "postgresql+asyncpg"
    }
  },
  "children": []
}
